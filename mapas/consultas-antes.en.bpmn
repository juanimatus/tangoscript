<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Consultas_antes" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Consultas_antes" name="WhatsApp inquiries · Before" isExecutable="false">
    <bpmn:startEvent id="N_s" name="Customer writes on WhatsApp">
      <bpmn:outgoing>F_s_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="N_t1" name="See the message when someone is around">
      <bpmn:incoming>F_s_t1</bpmn:incoming>
      <bpmn:outgoing>F_t1_t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_t2" name="Look the product up in the store and Mercado Libre">
      <bpmn:incoming>F_t1_t2</bpmn:incoming>
      <bpmn:outgoing>F_t2_g1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_g1" name="Product available?" default="F_g1_t4">
      <bpmn:incoming>F_t2_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_t3</bpmn:outgoing>
      <bpmn:outgoing>F_g1_t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_t3" name="Copy the link and reply">
      <bpmn:incoming>F_g1_t3</bpmn:incoming>
      <bpmn:outgoing>F_t3_g2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_t4" name="Find the local distributor by hand">
      <bpmn:incoming>F_g1_t4</bpmn:incoming>
      <bpmn:outgoing>F_t4_t5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_t5" name="Reply with the distributor">
      <bpmn:incoming>F_t4_t5</bpmn:incoming>
      <bpmn:outgoing>F_t5_g2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_g2">
      <bpmn:incoming>F_t3_g2</bpmn:incoming>
      <bpmn:incoming>F_t5_g2</bpmn:incoming>
      <bpmn:outgoing>F_g2_e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_e" name="Inquiry answered">
      <bpmn:incoming>F_g2_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_t1" sourceRef="N_s" targetRef="N_t1" />
    <bpmn:sequenceFlow id="F_t1_t2" sourceRef="N_t1" targetRef="N_t2" />
    <bpmn:sequenceFlow id="F_t2_g1" sourceRef="N_t2" targetRef="N_g1" />
    <bpmn:sequenceFlow id="F_g1_t3" name="Yes" sourceRef="N_g1" targetRef="N_t3" />
    <bpmn:sequenceFlow id="F_g1_t4" name="No" sourceRef="N_g1" targetRef="N_t4" />
    <bpmn:sequenceFlow id="F_t4_t5" sourceRef="N_t4" targetRef="N_t5" />
    <bpmn:sequenceFlow id="F_t3_g2" sourceRef="N_t3" targetRef="N_g2" />
    <bpmn:sequenceFlow id="F_t5_g2" sourceRef="N_t5" targetRef="N_g2" />
    <bpmn:sequenceFlow id="F_g2_e" sourceRef="N_g2" targetRef="N_e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Consultas_antes">
    <bpmndi:BPMNPlane id="BPMNPlane_Consultas_antes" bpmnElement="Consultas_antes">
      <bpmndi:BPMNShape id="N_s_di" bpmnElement="N_s">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t1_di" bpmnElement="N_t1">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t2_di" bpmnElement="N_t2">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g1_di" bpmnElement="N_g1" isMarkerVisible="true">
        <dc:Bounds x="500" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t3_di" bpmnElement="N_t3">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g2_di" bpmnElement="N_g2" isMarkerVisible="true">
        <dc:Bounds x="800" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_e_di" bpmnElement="N_e">
        <dc:Bounds x="957" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t4_di" bpmnElement="N_t4">
        <dc:Bounds x="625" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t5_di" bpmnElement="N_t5">
        <dc:Bounds x="775" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_s_t1_di" bpmnElement="F_s_t1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t1_t2_di" bpmnElement="F_t1_t2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t2_g1_di" bpmnElement="F_t2_g1">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="500" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t3_di" bpmnElement="F_g1_t3">
        <di:waypoint x="550" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t4_di" bpmnElement="F_g1_t4">
        <di:waypoint x="525" y="95" />
        <di:waypoint x="525" y="210" />
        <di:waypoint x="625" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t3_g2_di" bpmnElement="F_t3_g2">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="800" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g2_e_di" bpmnElement="F_g2_e">
        <di:waypoint x="850" y="70" />
        <di:waypoint x="957" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t4_t5_di" bpmnElement="F_t4_t5">
        <di:waypoint x="725" y="210" />
        <di:waypoint x="775" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t5_g2_di" bpmnElement="F_t5_g2">
        <di:waypoint x="825" y="170" />
        <di:waypoint x="825" y="95" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
