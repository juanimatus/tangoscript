        <di:waypoint x="618" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t3_g2_di" bpmnElement="F_t3_g2">
        <di:waypoint x="718" y="225" />
        <di:waypoint x="793" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t4_g2_di" bpmnElement="F_t4_g2">
        <di:waypoint x="718" y="375" />
        <di:waypoint x="756" y="375" />
        <di:waypoint x="756" y="225" />
        <di:waypoint x="793" y="225" />
