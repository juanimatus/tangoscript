      <bpmndi:BPMNShape id="N_g1_di" bpmnElement="N_g1">
        <dc:Bounds x="493" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t3_di" bpmnElement="N_t3">
        <dc:Bounds x="618" y="185" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_g2_di" bpmnElement="N_g2">
        <dc:Bounds x="793" y="200" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t5_di" bpmnElement="N_t5">
        <dc:Bounds x="918" y="185" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_e_di" bpmnElement="N_e">
        <dc:Bounds x="1100" y="57" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t4_di" bpmnElement="N_t4">
        <dc:Bounds x="618" y="335" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_s_t1_di" bpmnElement="F_s_t1">
        <di:waypoint x="86" y="75" />
        <di:waypoint x="127" y="75" />
        <di:waypoint x="127" y="225" />
        <di:waypoint x="168" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t1_t2_di" bpmnElement="F_t1_t2">
        <di:waypoint x="268" y="225" />
        <di:waypoint x="318" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t2_g1_di" bpmnElement="F_t2_g1">
        <di:waypoint x="418" y="225" />
        <di:waypoint x="493" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t3_di" bpmnElement="F_g1_t3">
