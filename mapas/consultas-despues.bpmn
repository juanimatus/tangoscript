<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Consultas_despues" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Consultas_despues" name="Consultas por WhatsApp · Después" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_c" name="Cliente">
        <bpmn:flowNodeRef>N_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_m" name="Make">
        <bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_d" name="Make · distribuidores">
        <bpmn:flowNodeRef>N_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_s" name="Cliente escribe, con errores o fuera de horario">
      <bpmn:outgoing>F_s_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="N_t1" name="Recibir y filtrar las consultas entrantes">
      <bpmn:incoming>F_s_t1</bpmn:incoming>
      <bpmn:outgoing>F_t1_t2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_t2" name="Buscar con motor propio en el catálogo">
      <bpmn:incoming>F_t1_t2</bpmn:incoming>
      <bpmn:outgoing>F_t2_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_g1" name="¿Qué necesita?" default="F_g1_t4">
      <bpmn:incoming>F_t2_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_t3</bpmn:outgoing>
      <bpmn:outgoing>F_g1_t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_t3" name="Elegir canal y armar el link (ante la duda, a la tienda)">
      <bpmn:incoming>F_g1_t3</bpmn:incoming>
      <bpmn:outgoing>F_t3_g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_t4" name="Ubicar el distribuidor por provincia y localidad">
      <bpmn:incoming>F_g1_t4</bpmn:incoming>
      <bpmn:outgoing>F_t4_g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_g2">
      <bpmn:incoming>F_t3_g2</bpmn:incoming>
      <bpmn:incoming>F_t4_g2</bpmn:incoming>
      <bpmn:outgoing>F_g2_t5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_t5" name="Responder por WhatsApp">
      <bpmn:incoming>F_g2_t5</bpmn:incoming>
      <bpmn:outgoing>F_t5_e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="N_e" name="Consulta respondida">
      <bpmn:incoming>F_t5_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_t1" sourceRef="N_s" targetRef="N_t1" />
    <bpmn:sequenceFlow id="F_t1_t2" sourceRef="N_t1" targetRef="N_t2" />
    <bpmn:sequenceFlow id="F_t2_g1" sourceRef="N_t2" targetRef="N_g1" />
    <bpmn:sequenceFlow id="F_g1_t3" name="Un producto" sourceRef="N_g1" targetRef="N_t3" />
    <bpmn:sequenceFlow id="F_g1_t4" name="Un distribuidor" sourceRef="N_g1" targetRef="N_t4" />
    <bpmn:sequenceFlow id="F_t3_g2" sourceRef="N_t3" targetRef="N_g2" />
    <bpmn:sequenceFlow id="F_t4_g2" sourceRef="N_t4" targetRef="N_g2" />
    <bpmn:sequenceFlow id="F_g2_t5" sourceRef="N_g2" targetRef="N_t5" />
    <bpmn:sequenceFlow id="F_t5_e" sourceRef="N_t5" targetRef="N_e" />
    <bpmn:textAnnotation id="Note_1">
      <bpmn:text>La planilla de distribuidores la actualiza el cliente</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="N_t4" targetRef="Note_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Consultas_despues">
    <bpmndi:BPMNPlane id="BPMNPlane_Consultas_despues" bpmnElement="Consultas_despues">
      <bpmndi:BPMNShape id="Lane_c_di" bpmnElement="Lane_c" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1126" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_m_di" bpmnElement="Lane_m" isHorizontal="true">
        <dc:Bounds x="30" y="150" width="1126" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_d_di" bpmnElement="Lane_d" isHorizontal="true">
        <dc:Bounds x="30" y="300" width="1126" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_s_di" bpmnElement="N_s">
        <dc:Bounds x="50" y="57" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="N_t1_di" bpmnElement="N_t1">
        <dc:Bounds x="168" y="185" width="100" height="80" />
