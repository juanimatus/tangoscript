<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Ensayos_despues" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Ensayos_despues" name="Trial photos · After" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_a" name="App">
        <bpmn:flowNodeRef>N_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_m" name="Make">
        <bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_i" name="AI">
        <bpmn:flowNodeRef>N_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_p" name="A person">
        <bpmn:flowNodeRef>N_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_s" name="Capture logged from the phone">
      <bpmn:outgoing>F_s_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="N_t1" name="Receive the capture and validate the key">
      <bpmn:incoming>F_s_t1</bpmn:incoming>
      <bpmn:outgoing>F_t1_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_g1" name="Duplicate capture?" default="F_g1_t2">
      <bpmn:incoming>F_t1_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_e1</bpmn:outgoing>
      <bpmn:outgoing>F_g1_t2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="N_e1" name="Capture already logged">
      <bpmn:incoming>F_g1_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="N_t2" name="Save photos and audio to Drive">
      <bpmn:incoming>F_g1_t2</bpmn:incoming>
      <bpmn:outgoing>F_t2_t3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_t3" name="Log the capture in the spreadsheet">
      <bpmn:incoming>F_t2_t3</bpmn:incoming>
      <bpmn:outgoing>F_t3_t4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_t4" name="Transcribe voice and handwritten notes">
      <bpmn:incoming>F_t3_t4</bpmn:incoming>
      <bpmn:outgoing>F_t4_t5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_t5" name="Read the label, describe the sample and pick the variety">
      <bpmn:incoming>F_t4_t5</bpmn:incoming>
      <bpmn:outgoing>F_t5_g2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_g2" name="Is the AI sure?" default="F_g2_t6">
      <bpmn:incoming>F_t5_g2</bpmn:incoming>
      <bpmn:outgoing>F_g2_g3</bpmn:outgoing>
      <bpmn:outgoing>F_g2_t6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_t6" name="Review the flagged capture">
      <bpmn:incoming>F_g2_t6</bpmn:incoming>
      <bpmn:outgoing>F_t6_g3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_g3">
      <bpmn:incoming>F_g2_g3</bpmn:incoming>
      <bpmn:incoming>F_t6_g3</bpmn:incoming>
      <bpmn:outgoing>F_g3_t7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="N_t7" name="File it in its variety and day folder, with code and date">
      <bpmn:incoming>F_g3_t7</bpmn:incoming>
      <bpmn:outgoing>F_t7_e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="N_e2" name="Capture filed">
      <bpmn:incoming>F_t7_e2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_t1" sourceRef="N_s" targetRef="N_t1" />
    <bpmn:sequenceFlow id="F_t1_g1" sourceRef="N_t1" targetRef="N_g1" />
    <bpmn:sequenceFlow id="F_g1_e1" name="Yes" sourceRef="N_g1" targetRef="N_e1" />
    <bpmn:sequenceFlow id="F_g1_t2" name="No" sourceRef="N_g1" targetRef="N_t2" />
    <bpmn:sequenceFlow id="F_t2_t3" sourceRef="N_t2" targetRef="N_t3" />
    <bpmn:sequenceFlow id="F_t3_t4" sourceRef="N_t3" targetRef="N_t4" />
    <bpmn:sequenceFlow id="F_t4_t5" sourceRef="N_t4" targetRef="N_t5" />
    <bpmn:sequenceFlow id="F_t5_g2" sourceRef="N_t5" targetRef="N_g2" />
    <bpmn:sequenceFlow id="F_g2_g3" name="Yes" sourceRef="N_g2" targetRef="N_g3" />
    <bpmn:sequenceFlow id="F_g2_t6" name="No" sourceRef="N_g2" targetRef="N_t6" />
    <bpmn:sequenceFlow id="F_t6_g3" sourceRef="N_t6" targetRef="N_g3" />
    <bpmn:sequenceFlow id="F_g3_t7" sourceRef="N_g3" targetRef="N_t7" />
    <bpmn:sequenceFlow id="F_t7_e2" sourceRef="N_t7" targetRef="N_e2" />
  </bpmn:process>
